{
  "type": "object",
  "title": "Helios iNuvio Connection",
  "required": [
    "base_url",
    "username",
    "#password",
    "database"
  ],
  "properties": {
    "base_url": {
      "type": "string",
      "title": "Server URL",
      "description": "Base URL of the Helios iNuvio application server, including the port (e.g. http://your-server:8080).",
      "propertyOrder": 10
    },
    "username": {
      "type": "string",
      "title": "Username",
      "propertyOrder": 20
    },
    "#password": {
      "type": "string",
      "title": "Password",
      "format": "password",
      "propertyOrder": 30
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 50
    },
    "database": {
      "type": "string",
      "title": "Database",
      "description": "Helios iNuvio database system name. Click the button to load available databases.",
      "format": "select",
      "enum": [],
      "propertyOrder": 60,
      "options": {
        "async": {
          "label": "Load Databases",
          "action": "list_databases"
        }
      }
    }
  }
}
